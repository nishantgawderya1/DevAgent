# LLM / embeddings
OPENAI_API_KEY=sk-...
# or
ANTHROPIC_API_KEY=sk-ant-...

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./certs/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Qdrant (local)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Where cloned repos are checked out for indexing (defaults to <tempdir>/devagent)
DEVAGENT_INDEX_ROOT=
