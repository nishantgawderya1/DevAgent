# LLM (chat completions over any OpenAI-compatible endpoint).
# Defaults to NVIDIA NIM / Nemotron. Verify the model id on build.nvidia.com --
# the catalog moves and ids get retired.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# LLM_TIMEOUT_SECONDS=120          # per-request ceiling
#
# Any OpenAI-compatible provider works by changing the three above, e.g.
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-3.5-sonnet
# The older OPENROUTER_* names are still read as a fallback.

# Embeddings are local (sentence-transformers all-MiniLM-L6-v2) — no key needed.

# GitHub — pick ONE auth method.
# 1. Token (simplest): a PAT with `repo` scope, or an installation token.
GITHUB_TOKEN=
# 2. GitHub App: used when GITHUB_TOKEN is unset; an installation token is minted.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./certs/github-app.pem

# Required for the /webhook endpoint. Unset means every delivery is rejected —
# the endpoint starts agent runs, so it fails closed rather than open.
GITHUB_WEBHOOK_SECRET=

# Identity on the commits DevAgent pushes.
DEVAGENT_GIT_NAME=DevAgent
DEVAGENT_GIT_EMAIL=devagent@users.noreply.github.com

# Qdrant (local)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Where cloned repos are checked out for indexing (defaults to <tempdir>/devagent)
DEVAGENT_INDEX_ROOT=

# Logging level for the FastAPI app (DEBUG, INFO, WARNING, ERROR)
DEVAGENT_LOG_LEVEL=INFO

# Bearer token for /runs, /runs/{id} and /webhook/manual. Unset rejects every
# request to them -- these endpoints start runs and expose diffs, so they fail
# closed rather than open.
DEVAGENT_API_TOKEN=

# Run history database (defaults to <index root>/devagent.db)
DEVAGENT_DB_PATH=

# Wall-clock ceiling for one run, in seconds (default 1800)
DEVAGENT_RUN_TIMEOUT_SECONDS=1800
